# Copy to .env and fill in. Never commit the real file.

# Signs sign-in tokens. Required in production: at least 32 random characters.
MONITOR_SECRET=

# Gateways send readings with this key in the X-Ingest-Key header. Leave empty to keep the intake closed.
MONITOR_INGEST_KEY=

# MQTT intake: subscribe to a broker as well as taking POST /api/ingest. Off while the URL is empty.
# mqtt://, mqtts:// (TLS), ws:// or wss://, for example mqtts://broker.plant.local:8883
MONITOR_MQTT_URL=
MONITOR_MQTT_USERNAME=
MONITOR_MQTT_PASSWORD=
# Topic filter to subscribe to.
MONITOR_MQTT_TOPIC=mouldcare/#
# Optional. With a fixed client ID the broker keeps the session and holds QoS 1 messages while Monitor restarts.
MONITOR_MQTT_CLIENT_ID=

# Machine connectors (OPC UA / Euromap 77, Euromap 63, Modbus TCP) are set up in Settings › Connections & models.
# Set to off on a server that cannot reach the plant network.
MONITOR_CONNECTORS=on
# Euromap 63 session folders must be inside this folder (default: <data dir>/euromap63). Mount the machines' shares here.
MONITOR_EUROMAP63_ROOT=
# OPC UA passwords can be typed in Settings (stored encrypted) or read from variables named MONITOR_CONNECTOR_*,
# for example:
# MONITOR_CONNECTOR_IMM07_PASSWORD=

# First administrator (created once, if the email does not exist yet). Password: at least 12 characters.
MONITOR_ADMIN_EMAIL=
MONITOR_ADMIN_PASSWORD=

# AI assistant: an Anthropic API key from console.anthropic.com. Leave empty to use the built-in explanations only.
ANTHROPIC_API_KEY=
# Optional: another Claude model.
MONITOR_AI_MODEL=

# Hand-off to MouldCare: approved ticket drafts are sent there as breakdown tickets. The URL is MouldCare's address;
# the key is a company integration key made in MouldCare (npm run integration:key there). Leave empty to keep it off.
MONITOR_MOULDCARE_URL=
MONITOR_MOULDCARE_KEY=

# Demo only: demo machines (and demo accounts), and simulated readings. Keep both off where real machine data lives.
MONITOR_SEED_DEMO=false
# With demo data on a public site, set this to false: the demo accounts share a published password.
MONITOR_DEMO_ACCOUNTS=true
MONITOR_SIMULATOR=false

# How long readings are kept (days).
MONITOR_RETENTION_DAYS=30
PORT=3300
