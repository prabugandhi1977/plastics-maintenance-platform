# Copy to .env (never commit .env) and fill in. Generate secrets with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
MOULDCARE_SECRET=
MOULDCARE_INTEGRATION_KEY=

# First platform admin for a real deployment (password 12+ characters; change it after first sign-in).
MOULDCARE_ADMIN_EMAIL=
MOULDCARE_ADMIN_PASSWORD=

# Demo accounts share the password DemoPass123!. Only enable on a private machine, never on a public server.
MOULDCARE_SEED_DEMO=false

# Machine data: mock adapter until the real API is connected; 0 disables polling.
IOT_SYNC_ADAPTER=mock
IOT_SYNC_INTERVAL_SECONDS=0

# Smart factory simulator: invents realistic machine states, output and alerts for production machines.
# For demos on a private machine only; never on a site with real customer data.
FACTORY_SIMULATOR=false

# Alert emails (critical alerts by default). Provider: brevo, sendgrid or resend; EMAIL_FROM must be a sender
# address verified with that provider. Leave empty to keep emails in the outbox without sending.
EMAIL_PROVIDER=
EMAIL_API_KEY=
EMAIL_FROM=

HOST_PORT=3100
